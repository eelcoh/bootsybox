#!/bin/bash
set -euo pipefail

SOCKET=${BOOTSYBOX_UPDATE_SOCKET:-/run/bootsybox-update.sock}

usage() {
    echo "usage: bootsybox {host|desktop} {status|upgrade|rollback} [--check|--apply]" >&2
    exit 2
}

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    usage
fi
[ -S "$SOCKET" ] || { echo "Bootsybox update service is unavailable" >&2; exit 1; }

SCOPE=$1
ACTION=$2
OPTION=${3:-none}
case "$SCOPE:$ACTION:$OPTION" in
    host:status:none|host:upgrade:none|host:upgrade:--check|host:upgrade:--apply|host:rollback:--apply|\
    desktop:status:none|desktop:upgrade:none|desktop:upgrade:--check|desktop:upgrade:--apply|desktop:rollback:--apply)
        ;;
    *) usage ;;
esac

# A check may spend more than socat's default half-second EOF grace period in
# skopeo or bootc. Keep the response side open for long-running operations;
# socat still exits immediately when the broker closes normally. Otherwise the
# handler writes into a closed socket (and bootc currently aborts on that
# broken pipe).
printf '%s %s %s %s\n' "$SCOPE" "$ACTION" "$OPTION" "$(id -un)" |
    socat -t 3600 STDIO "UNIX-CONNECT:$SOCKET" |
    awk '
        /^__BOOTSYBOX_PROTOCOL__ 1$/ {
            protocol = 1
            next
        }
        /^__BOOTSYBOX_RESULT__ [0-9]+$/ {
            seen = 1
            result = $2
            next
        }
        { print; fflush() }
        END {
            if (protocol && !seen) {
                print "error: update service ended without a result" > "/dev/stderr"
                exit 1
            }
            if (!protocol)
                exit 0
            exit (result == 0 ? 0 : 1)
        }
    '
