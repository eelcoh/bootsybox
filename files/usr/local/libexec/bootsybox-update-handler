#!/bin/bash
set -euo pipefail

DEFAULT_DESKTOP_IMAGE_FILE=/usr/share/bootsybox/desktop-image
OVERRIDE_DESKTOP_IMAGE_FILE=/etc/bootsybox/desktop-image
HOST_IMAGE=ghcr.io/eelcoh/bootsybox-host:44
COMPATIBILITY_CHECKER=/usr/local/libexec/bootsybox-check-compatibility
EXPECTED_DESKTOP_API=1
HOST_API=1
RESULT_PREFIX=__BOOTSYBOX_RESULT__
PROTOCOL_PREFIX=__BOOTSYBOX_PROTOCOL__

emit_result() {
    local rc=$?
    trap - EXIT
    printf '%s %s\n' "$RESULT_PREFIX" "$rc"
    exit "$rc"
}

trap emit_result EXIT
printf '%s 1\n' "$PROTOCOL_PREFIX"

fail() {
    echo "error: $*" >&2
    exit 1
}

read -r SCOPE ACTION OPTION REQUEST_USER EXTRA || fail "invalid request"
[ -z "${EXTRA:-}" ] || fail "invalid request"
[[ "$REQUEST_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid user"
id "$REQUEST_USER" >/dev/null 2>&1 || fail "unknown user"
id -nG "$REQUEST_USER" | tr ' ' '\n' | grep -qx wheel || fail "user is not an administrator"

REQUEST_UID=$(id -u "$REQUEST_USER")
REQUEST_HOME=$(getent passwd "$REQUEST_USER" | cut -d: -f6)
STATE_DIR="$REQUEST_HOME/.local/state/bootsybox"
STAGED_FILE="$STATE_DIR/staged-image"
LAST_GOOD_FILE="$STATE_DIR/last-good-image"
ROLLBACK_FILE="$STATE_DIR/rollback-image"
FAILED_FILE="$STATE_DIR/failed-image"
AVAILABLE_FILE="$STATE_DIR/available-image"
AVAILABLE_VERSION_FILE="$STATE_DIR/available-version"
UPDATE_AVAILABLE_FILE="$STATE_DIR/update-available"
CONTAINER_NAME="desktop-env-$REQUEST_USER"
DESKTOP_IMAGE_FILE=$DEFAULT_DESKTOP_IMAGE_FILE
if [ -r "$OVERRIDE_DESKTOP_IMAGE_FILE" ]; then
    DESKTOP_IMAGE_FILE=$OVERRIDE_DESKTOP_IMAGE_FILE
fi
DESKTOP_IMAGE=$(tr -d '[:space:]' < "$DESKTOP_IMAGE_FILE")

as_user() {
    runuser -u "$REQUEST_USER" -- env \
        HOME="$REQUEST_HOME" \
        USER="$REQUEST_USER" \
        XDG_RUNTIME_DIR="/run/user/$REQUEST_UID" \
        "$@"
}

write_state() {
    local file=$1
    local value=$2
    install -d -m 0700 -o "$REQUEST_UID" -g "$(id -g "$REQUEST_USER")" "$STATE_DIR"
    printf '%s\n' "$value" > "$file"
    chown "$REQUEST_UID:$(id -g "$REQUEST_USER")" "$file"
    chmod 0600 "$file"
}

desktop_status() {
    local running_image staged_image
    echo "declared: $DESKTOP_IMAGE"
    if as_user podman container exists "$CONTAINER_NAME"; then
        running_image=$(as_user podman container inspect --format '{{.Image}}' "$CONTAINER_NAME")
        echo "running-image: $running_image"
        echo "running-version: $(as_user podman image inspect --format '{{index .Labels "org.opencontainers.image.version"}}' "$running_image")"
        echo "running-revision: $(as_user podman image inspect --format '{{index .Labels "org.opencontainers.image.revision"}}' "$running_image")"
    else
        echo "running-image: none"
        echo "running-version: none"
        echo "running-revision: none"
    fi
    staged_image=$(cat "$STAGED_FILE" 2>/dev/null || echo none)
    echo "staged-image: $staged_image"
    if [ "$staged_image" != none ] && as_user podman image exists "$staged_image"; then
        echo "staged-version: $(as_user podman image inspect --format '{{index .Labels "org.opencontainers.image.version"}}' "$staged_image")"
    else
        echo "staged-version: none"
    fi
    echo "available-image: $(cat "$AVAILABLE_FILE" 2>/dev/null || echo unknown-run-upgrade-check)"
    echo "available-version: $(cat "$AVAILABLE_VERSION_FILE" 2>/dev/null || echo unknown-run-upgrade-check)"
    echo "update-available: $(cat "$UPDATE_AVAILABLE_FILE" 2>/dev/null || echo unknown-run-upgrade-check)"
    echo "last-known-good: $(cat "$LAST_GOOD_FILE" 2>/dev/null || echo none)"
    echo "rollback-image: $(cat "$ROLLBACK_FILE" 2>/dev/null || echo none)"
    echo "failed-image: $(cat "$FAILED_FILE" 2>/dev/null || echo none)"
}

desktop_check() {
    local remote remote_digest remote_version local_digest available
    remote=$(skopeo inspect --format '{{.Digest}}|{{index .Labels "org.opencontainers.image.version"}}' "docker://$DESKTOP_IMAGE")
    remote_digest=${remote%%|*}
    remote_version=${remote#*|}
    local_digest=$(as_user podman image inspect --format '{{.Digest}}' "$DESKTOP_IMAGE" 2>/dev/null || true)
    available=yes
    if [ "$remote_digest" = "$local_digest" ]; then
        available=no
    fi
    write_state "$AVAILABLE_FILE" "$remote_digest"
    write_state "$AVAILABLE_VERSION_FILE" "${remote_version:-unknown}"
    write_state "$UPDATE_AVAILABLE_FILE" "$available"
    echo "remote-digest: $remote_digest"
    echo "remote-version: ${remote_version:-unknown}"
    echo "local-digest: ${local_digest:-none}"
    echo "update-available: $available"
}

desktop_stage() {
    local image_id image_api required_host_api
    as_user podman pull "$DESKTOP_IMAGE"
    image_id=$(as_user podman image inspect --format '{{.Id}}' "$DESKTOP_IMAGE")
    image_api=$(as_user podman image inspect --format '{{index .Labels "io.bootsybox.desktop.api"}}' "$DESKTOP_IMAGE")
    required_host_api=$(as_user podman image inspect --format '{{index .Labels "io.bootsybox.desktop.host-api"}}' "$DESKTOP_IMAGE")
    "$COMPATIBILITY_CHECKER" "$HOST_API" "$EXPECTED_DESKTOP_API" "$image_api" "$required_host_api"
    write_state "$STAGED_FILE" "$image_id"
    rm -f "$FAILED_FILE"
    echo "staged-image: $image_id"
}

selected_desktop_image() {
    if [ -r "$STAGED_FILE" ] && as_user podman image exists "$(cat "$STAGED_FILE")"; then
        cat "$STAGED_FILE"
    elif as_user podman container exists "$CONTAINER_NAME"; then
        as_user podman container inspect --format '{{.Image}}' "$CONTAINER_NAME"
    elif [ -r "$LAST_GOOD_FILE" ] && as_user podman image exists "$(cat "$LAST_GOOD_FILE")"; then
        cat "$LAST_GOOD_FILE"
    else
        echo "$DESKTOP_IMAGE"
    fi
}

host_preflight() {
    local candidate_host_api candidate_desktop_api desktop_image desktop_api required_host_api
    candidate_host_api=$(skopeo inspect --format '{{index .Labels "io.bootsybox.host.api"}}' "docker://$HOST_IMAGE")
    candidate_desktop_api=$(skopeo inspect --format '{{index .Labels "io.bootsybox.host.desktop-api"}}' "docker://$HOST_IMAGE")
    desktop_image=$(selected_desktop_image)
    if as_user podman image exists "$desktop_image"; then
        desktop_api=$(as_user podman image inspect --format '{{index .Labels "io.bootsybox.desktop.api"}}' "$desktop_image")
        required_host_api=$(as_user podman image inspect --format '{{index .Labels "io.bootsybox.desktop.host-api"}}' "$desktop_image")
    else
        desktop_api=$EXPECTED_DESKTOP_API
        required_host_api=$HOST_API
    fi
    "$COMPATIBILITY_CHECKER" \
        "$candidate_host_api" "$candidate_desktop_api" "$desktop_api" "$required_host_api"
}

host_upgrade() {
    host_preflight
    bootc upgrade "$@"
}

request_logout() {
    local niri_socket
    as_user podman container exists "$CONTAINER_NAME" || return 0
    # The inner shell, not this handler, expands the socket variable.
    # shellcheck disable=SC2016
    niri_socket=$(as_user podman exec "$CONTAINER_NAME" /bin/bash -c \
        'for socket in /run/user/*/niri.*.sock; do [ -S "$socket" ] && { echo "$socket"; exit; }; done') || true
    [ -n "$niri_socket" ] || fail "could not locate the running niri IPC socket"
    as_user podman exec \
        -u "$REQUEST_UID" \
        -e NIRI_SOCKET="$niri_socket" \
        "$CONTAINER_NAME" niri msg action quit || fail "could not request graphical logout"
}

desktop_apply() {
    [ -r "$STAGED_FILE" ] || desktop_stage
    echo "The staged desktop will be activated when this session exits."
    request_logout
}

desktop_rollback() {
    [ -r "$ROLLBACK_FILE" ] || fail "no rollback desktop image"
    local image_id
    image_id=$(cat "$ROLLBACK_FILE")
    as_user podman image exists "$image_id" || fail "rollback image is no longer cached"
    write_state "$STAGED_FILE" "$image_id"
    echo "staged rollback image: $image_id"
    request_logout
}

case "$SCOPE:$ACTION:$OPTION" in
    host:status:none) bootc status ;;
    host:upgrade:--check) host_upgrade --check ;;
    host:upgrade:none) host_upgrade ;;
    host:upgrade:--apply) host_upgrade --apply ;;
    host:rollback:--apply) bootc rollback --apply ;;
    desktop:status:none) desktop_status ;;
    desktop:upgrade:--check) desktop_check ;;
    desktop:upgrade:none) desktop_stage ;;
    desktop:upgrade:--apply) desktop_apply ;;
    desktop:rollback:--apply) desktop_rollback ;;
    *) fail "unsupported operation" ;;
esac
