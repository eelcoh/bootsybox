# greetd hands off to the session command without registering a logind seat
# session for the logged-in user (only the greeter's own session shows up in
# `loginctl list-sessions` — see the launch-user-container.sh comment for
# details), so the usual per-session device ACLs from logind never apply to
# the desktop container. Grant static group access to the VT/console devices
# instead: members of bootsybox-seat (see Containerfile) get rw access
# regardless of which VT they're actually attached to. This is coarser than
# per-session ACLs (any member can touch any VT, not just their own), but
# there's only one physical console anyway.
KERNEL=="tty[0-9]*", GROUP="bootsybox-seat", MODE="0660"
KERNEL=="console", GROUP="bootsybox-seat", MODE="0660"
